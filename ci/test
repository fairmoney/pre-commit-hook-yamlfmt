#!/bin/bash
set -eEu
set -o pipefail

################################################################################
# Run the test harness.
# Invoke from the root of the git repo as "ci/test".
################################################################################
. ci/functions.sh

run pre_commit_hooks/yamlfmt --help
echo

run pre-commit try-repo . --files .pre-commit-config.yaml

while read -r file; do
    run pre_commit_hooks/yamlfmt --mapping 4 --sequence 6 --offset 4 "${file}"
done < <(find . -regex '.*\.yaml')

echo "[INFO] Use with xargs"
find . -regex '.*\.yaml' -print0 |
    xargs -0 pre_commit_hooks/yamlfmt -m 4 -s 6 -o 4
echo

run pre_commit_hooks/yamlfmt -m 2 -s 2 -o 0 .pre-commit-hooks.yaml

# Ensure we never break multidoc.
TMP_FILE="$(mktemp pre-commit-hook-yamlfmt-test.XXXXXXXXXXXXXXXXXXXX)"
run cp -f ci/multidoc-before.txt "${TMP_FILE}"
run pre_commit_hooks/yamlfmt --mapping 4 --sequence 6 --offset 4 "${TMP_FILE}"
run diff ci/multidoc-after.yaml "${TMP_FILE}"
# If the diff fails, the temp file is still there to inspect.
run rm -f "${TMP_FILE}"

# Test preserve quotes
TMP_FILE="$(mktemp pre-commit-hook-yamlfmt-test.XXXXXXXXXXXXXXXXXXXX)"
run cp -f ci/quotes-before.txt "${TMP_FILE}"
run pre_commit_hooks/yamlfmt --mapping 4 --sequence 6 --offset 4 --preserve-quotes "${TMP_FILE}"
run diff ci/quotes-after.txt "${TMP_FILE}"
# If the diff fails, the temp file is still there to inspect.
run rm -f "${TMP_FILE}"

# Test preserve quotes
TMP_FILE="$(mktemp pre-commit-hook-yamlfmt-test.XXXXXXXXXXXXXXXXXXXX)"
run cp -f ci/nulls-before.txt "${TMP_FILE}"
run pre_commit_hooks/yamlfmt --mapping 4 --sequence 6 --offset 4 --null-value null "${TMP_FILE}"
run diff ci/nulls-after.txt "${TMP_FILE}"
# If the diff fails, the temp file is still there to inspect.
run rm -f "${TMP_FILE}"

# Test width setting
TMP_FILE="$(mktemp pre-commit-hook-yamlfmt-test.XXXXXXXXXXXXXXXXXXXX)"
run cp -f ci/test-long.txt "${TMP_FILE}"
run pre_commit_hooks/yamlfmt --width 250 "${TMP_FILE}"
# Width=250, no change
run diff ci/test-long.txt "${TMP_FILE}"
run pre_commit_hooks/yamlfmt --width 79 "${TMP_FILE}"
# Now we should see no lines > 81 (it has some offset in ruamel)
run grep -v -q '.\{82\}' "${TMP_FILE}"
run rm -f "${TMP_FILE}"

# Test sorting keys
TMP_FILE="$(mktemp pre-commit-hook-yamlfmt-test.XXXXXXXXXXXXXXXXXXXX)"
run cp -f ci/sort-before.txt "${TMP_FILE}"
run pre_commit_hooks/yamlfmt --mapping 4 --sequence 6 --offset 4 --sort_keys "${TMP_FILE}"
run diff ci/sort-after.txt "${TMP_FILE}"
# If the diff fails, the temp file is still there to inspect.
run rm -f "${TMP_FILE}"

# Test sorting keys keeps anchors
TMP_FILE="$(mktemp pre-commit-hook-yamlfmt-test.XXXXXXXXXXXXXXXXXXXX)"
run cp -f ci/anchors-before.txt "${TMP_FILE}"
run pre_commit_hooks/yamlfmt --mapping 2 --sequence 4 --offset 2 --sort_keys "${TMP_FILE}"
run diff ci/anchors-after.txt "${TMP_FILE}"
# If the diff fails, the temp file is still there to inspect.
run rm -f "${TMP_FILE}"

# Test sorting keys fails when a use of an anchor would move before its definition
# Each case is <fixture>:<anchor the error must name>
for CASE in reversed:base reversed-merge:b reversed-key:k; do
    BEFORE="ci/anchors-${CASE%%:*}-before.txt"
    ANCHOR="&${CASE##*:}"
    TMP_FILE="$(mktemp pre-commit-hook-yamlfmt-test.XXXXXXXXXXXXXXXXXXXX)"
    ERR_FILE="$(mktemp pre-commit-hook-yamlfmt-test.XXXXXXXXXXXXXXXXXXXX)"
    run cp -f "${BEFORE}" "${TMP_FILE}"
    echo "[RUN] pre_commit_hooks/yamlfmt --mapping 2 --sequence 4 --offset 2 --sort_keys ${TMP_FILE}" >&2
    if pre_commit_hooks/yamlfmt --mapping 2 --sequence 4 --offset 2 --sort_keys "${TMP_FILE}" 2>"${ERR_FILE}"; then
        err "expected yamlfmt to fail on ${BEFORE}: an alias sorted before ${ANCHOR}"
        exit 1
    fi
    echo
    run grep -qF "anchor ${ANCHOR} is defined" "${ERR_FILE}"
    run diff "${BEFORE}" "${TMP_FILE}"
    # If the diff fails, the temp file is still there to inspect.
    run rm -f "${TMP_FILE}" "${ERR_FILE}"
done

run pre-commit run --all-files --hook-stage manual
